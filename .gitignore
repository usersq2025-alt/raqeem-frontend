# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc

# local HQ bot drop zone (optional)
/hq-inbox/*
!/hq-inbox/.gitkeep

# duplication bot reports
/reports/

# leftover editor/agent scratch files
.tmp*
**/.tmp*
/tmp/

# source masters for knockout (ship WebP only)
**/*.source.*
**/*.source
# Local tool backups are not production source
/tools/*_backup_*/

# Never commit nested dependency folders or local social-bot data
**/node_modules/
/tools/social-post-bot/data/
