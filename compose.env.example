# Deploy-time parameters for docker-compose.yaml. Copy to `.env` next to
# docker-compose.yaml on the host; docker compose reads that automatically
# for the ${VAR} substitutions.
#
# These are NOT secrets (unlike raqeem-api's compose.env, which has real DB
# passwords) — safe to keep as committed defaults.

PROJECT_NAME=raqeem-frontend
IMAGE_NAME=raqeem-frontend
APP_VERSION=latest

# Host-side bind (compose.yaml already pins this to 127.0.0.1 — whatever
# reverse proxy is chosen later reaches it from there, this port is never
# exposed publicly). 17001 assigned specifically for this project by the
# server admin (raqeem-api moved to 17002 to free this one up).
HOST_PORT=17001
